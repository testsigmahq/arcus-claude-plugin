{
  "description": "Append-only context capture: lifecycle + full tool stream (async where safe).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/arcus-py.cmd\" \"${CLAUDE_PLUGIN_ROOT}/scripts/capture_hook.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/arcus-py.cmd\" \"${CLAUDE_PLUGIN_ROOT}/scripts/capture_hook.py\"",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/arcus-py.cmd\" \"${CLAUDE_PLUGIN_ROOT}/scripts/capture_hook.py\"",
            "async": true,
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/arcus-py.cmd\" \"${CLAUDE_PLUGIN_ROOT}/scripts/capture_hook.py\"",
            "async": true,
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/arcus-py.cmd\" \"${CLAUDE_PLUGIN_ROOT}/scripts/capture_hook.py\"",
            "async": true,
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/arcus-py.cmd\" \"${CLAUDE_PLUGIN_ROOT}/scripts/capture_hook.py\"",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/arcus-py.cmd\" \"${CLAUDE_PLUGIN_ROOT}/scripts/capture_hook.py\"",
            "async": true,
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/arcus-py.cmd\" \"${CLAUDE_PLUGIN_ROOT}/scripts/capture_hook.py\"",
            "async": true,
            "timeout": 600
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/arcus-py.cmd\" \"${CLAUDE_PLUGIN_ROOT}/scripts/capture_hook.py\"",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/arcus-py.cmd\" \"${CLAUDE_PLUGIN_ROOT}/scripts/capture_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
